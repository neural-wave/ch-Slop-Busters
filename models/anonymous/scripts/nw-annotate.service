# Optional: resumes annotation automatically after VM resets. Install manually:
#   sudo cp scripts/nw-annotate.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now nw-annotate
[Unit]
Description=Neuralwave resumable annotation (headless scoped Claude Code)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=86400
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/neuralwave
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -u scripts/annotate_headless.py
StandardOutput=append:/home/ubuntu/neuralwave/outputs/logs/annotate_service.log
StandardError=append:/home/ubuntu/neuralwave/outputs/logs/annotate_service.log
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
