# Patient data, silver labels, generated outputs and model weights never go into Git.
# Anchored to the project root, so src/unified_harness/data/ (public lexicons), scripts/labels/ and
# tests/data/ (tests that read local data) are tracked.
/data/
/labels/
/outputs/
/models/
*.jsonl
!tests/fixtures/*.jsonl
# When this project sits inside another repository whose .gitignore ignores data/ anywhere:
!src/unified_harness/data/
!tests/data/

# Local working notes: never published
/PLAN.md
/STATUS.md

# Python and tooling
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# OS and editors
.DS_Store
.idea/
.vscode/
